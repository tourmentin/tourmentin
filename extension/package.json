{
  "name": "tourmentin-extension",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "preparer-socle": "node scripts/preparer-socle.mjs",
    "predev": "npm run preparer-socle",
    "prebuild": "npm run preparer-socle",
    "pretest": "npm run preparer-socle",
    "dev": "vite",
    "build:chrome": "vite build --mode chrome",
    "build:publication-test": "node scripts/build-publication-test.mjs",
    "build:firefox": "vite build --mode firefox",
    "installer": "node scripts/construire-installer.mjs",
    "signer:firefox": "node scripts/signer-firefox.mjs",
    "postbuild:chrome": "node scripts/ajouter-licence.mjs chrome-essai && node scripts/verifier-build-essai.mjs",
    "postbuild:firefox": "node scripts/ajouter-licence.mjs firefox-essai",
    "servir-pages": "node tests/e2e/servir-pages.mjs",
    "verifier-build-essai": "node scripts/verifier-build-essai.mjs",
    "build:mesure": "node scripts/build-mesure.mjs",
    "build": "npm run build:chrome && npm run build:firefox",
    "preharnais": "npm run build:mesure",
    "harnais": "node tests/corpus/harnais.mjs",
    "premesure-latence": "npm run build:mesure",
    "mesure-latence": "node tests/corpus/harnais.mjs --mesure-latence",
    "comparer-latence": "node tests/corpus/comparer-latence.mjs",
    "mesurer-cout-adaptateur": "node tests/corpus/mesurer-cout-adaptateur.mjs",
    "reevaluer-socle-affiche": "node tests/corpus/reevaluer-socle-affiche.mjs",
    "recenser-contexte-are": "node tests/corpus/recenser-contexte-are.mjs",
    "prediagnostiquer-queue-c4": "npm run build:mesure",
    "diagnostiquer-queue-c4": "node tests/corpus/diagnostiquer-queue-c4.mjs",
    "mesurer-collisions-termes-forts": "node tests/corpus/mesurer-collisions-termes-forts.mjs",
    "mesurer-cout-exposition-identifiant": "node tests/corpus/mesurer-cout-exposition-identifiant.mjs",
    "mesurer-cout-candidat-a-connexions": "node tests/corpus/mesurer-cout-candidat-a-connexions.mjs",
    "mesurer-co-presence-termes-faibles": "node tests/corpus/mesurer-co-presence-termes-faibles.mjs",
    "verifier-mires-socle": "node tests/corpus/verifier-mires-socle.mjs",
    "construire-corpus-connexions": "node tests/corpus/construire-corpus-connexions.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "diagnostiquer-connexion": "node tests/corpus/diagnostiquer-connexion.mjs",
    "relever-mutuelles": "node tests/corpus/relever-mutuelles.mjs",
    "diagnostiquer-injoignables-mutuelles": "node tests/corpus/diagnostiquer-injoignables-mutuelles.mjs",
    "premesurer-reveil-service-worker": "npm run build:mesure",
    "mesurer-reveil-service-worker": "node tests/corpus/mesurer-reveil-service-worker.mjs",
    "reporter-verification-manuelle": "node tests/corpus/reporter-verification-manuelle.mjs",
    "lint:firefox": "web-ext lint -s dist/firefox-essai --self-hosted"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "selenium-webdriver": "^4.51.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vitest": "^3.0.0",
    "web-ext": "^10.7.0"
  },
  "dependencies": {
    "tldts": "^7.4.12"
  }
}
